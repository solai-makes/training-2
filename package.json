{
  "name": "training2",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "codegen:openapi": "tsx tools/codegen/emit-openapi.ts",
    "codegen": "pnpm codegen:openapi",
    "seed:cognito": "bash .devcontainer/cognito/seed.sh",
    "dev:public-api": "pnpm --filter @training2/public-api dev",
    "dev:private-api": "pnpm --filter @training2/private-api dev",
    "prepare": "husky",
    "dev": "pnpm setup:local && pnpm -r --parallel --filter './apps/*' run dev",
    "setup:local": "node apps/private-api/src/setup.ts && pnpm --filter @training2/prisma codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "nodemon": "3.1.14",
    "typescript": "^7.0.2"
  }
}
